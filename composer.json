{
    "name": "makermind/erd4dev",
    "description": "A Laravel/Livewire ER-diagram editor that turns visual database designs into relational schemas, SQL exports, and Laravel Blueprint drafts.",
    "keywords": ["laravel", "livewire", "erd", "database", "schema", "diagram", "sql", "blueprint"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/view": "^13.0",
        "livewire/livewire": "^4.3",
        "getartisanflow/wireflow": "0.2.4-alpha",
        "laravel-shift/blueprint": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "Makermind\\Erd4dev\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Makermind\\Erd4dev\\ErdServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Makermind",
            "homepage": "https://github.com/makermindclub",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/makermindclub/erd4dev",
    "support": {
        "issues": "https://github.com/makermindclub/erd4dev/issues",
        "source": "https://github.com/makermindclub/erd4dev"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
